#!/bin/bash

# Exit immediately if a command exits with a non-zero status
set -e

ACTION=$1
REPO_NAME=$2
WT_NAME=$3

# Configuration
BASE_DEV_DIR="$HOME/dev"
BASE_WT_DIR="$HOME/dev/worktrees"

# Display usage instructions
usage() {
    echo "Usage: $0 [add|rm] [repo_name] [worktree_name]"
    echo "Example: $0 add gayl feat/login"
    echo "Example: $0 rm appserver hotfix/auth"
    exit 1
}

# Validate inputs
if [[ -z "$ACTION" || -z "$REPO_NAME" || -z "$WT_NAME" ]]; then
    usage
fi

REPO_DIR="$BASE_DEV_DIR/$REPO_NAME"
WT_DIR="$BASE_WT_DIR/$REPO_NAME/$WT_NAME"

if [[ ! -d "$REPO_DIR" ]]; then
    echo "Error: Main repository not found at $REPO_DIR"
    exit 1
fi

# ---------------------------------------------------------
# Custom Initialization Logic
# ---------------------------------------------------------
run_custom_init() {
    local target_dir=$1
    local repo=$2

    echo "Running custom initialization for $repo in $target_dir..."
    
    # Move into the new worktree directory to run setup commands
    cd "$target_dir"

    case "$repo" in
        gayl)
            # Add gayl-specific setup here
            echo "-> Initialized gayl worktree."

            # Required for the app to function
            echo "Creating secrets..."
            cd infra/parameterstore/
            npm i
            ./generate-dev-secrets.mjs

            # Required for templates to render
            echo "Creating webpack build output file..."
            cd "$target_dir"
            touch client/velocity/settings/macros/resource-array-final.vm
            ;;
        appserver)
            # Add appserver-specific setup here
            echo "-> Initialized appserver worktree."
            ;;
        *)
            echo "-> No custom init defined for $repo."
            ;;
    esac
}

# ---------------------------------------------------------
# Actions
# ---------------------------------------------------------
if [[ "$ACTION" == "add" ]]; then
    
    if [[ -d "$WT_DIR" ]]; then
        echo "Error: Worktree already exists at $WT_DIR"
        exit 1
    fi

    # Create the parent directories for the worktree, accounting for slashes in the branch name
    mkdir -p "$(dirname "$WT_DIR")"

    echo "Creating new worktree for $REPO_NAME at $WT_DIR..."
    
    # Check if the branch already exists locally
    if git -C "$REPO_DIR" show-ref --verify --quiet "refs/heads/$WT_NAME"; then
        echo "Branch '$WT_NAME' exists. Checking it out in new worktree..."
        git -C "$REPO_DIR" worktree add "$WT_DIR" "$WT_NAME"
    else
        echo "Creating new branch '$WT_NAME'..."
        git -C "$REPO_DIR" worktree add -b "$WT_NAME" "$WT_DIR"
    fi

    # Run the custom initialization
    run_custom_init "$WT_DIR" "$REPO_NAME"

    echo "✅ Worktree ready: $WT_DIR"

elif [[ "$ACTION" == "rm" ]]; then
    
    if [[ ! -d "$WT_DIR" ]]; then
        echo "Error: No worktree found at $WT_DIR"
        exit 1
    fi

    echo "Removing worktree at $WT_DIR..."
    
    # Let Git cleanly remove the worktree
    git -C "$REPO_DIR" worktree remove "$WT_DIR"
    
    echo "✅ Worktree removed."
    echo "(Note: The branch '$WT_NAME' still exists in your git history. Delete it manually with 'git branch -d \"$WT_NAME\"' if you no longer need it)."

else
    usage
fi